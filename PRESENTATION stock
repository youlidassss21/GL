package presentation;

import accesDonnees.StockManager;
import metier.Produit;
import javax.swing.*;
import javax.swing.table.DefaultTableCellRenderer;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.sql.SQLException;
import java.util.List;

public class GestionStock extends JFrame {

    private StockManager manager;
    private JTable table;
    private DefaultTableModel model;
    
    
    private JTextField txtNom, txtQte, txtSeuil, txtFournisseur;

    public GestionStock() {
        manager = new StockManager();
        
        setTitle("Gestion du Stock & Alertes");
        setSize(800, 600);
        setLocationRelativeTo(null);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        
       
        verifierAlertesDemarrage();

        
        JPanel panelForm = new JPanel(new GridLayout(5, 2, 10, 10));
        panelForm.setBorder(BorderFactory.createTitledBorder("Nouveau Produit"));
        panelForm.setBackground(new Color(255, 250, 240)); // Blanc cassé

        txtNom = new JTextField();
        txtQte = new JTextField();
        txtSeuil = new JTextField("10"); 
        txtFournisseur = new JTextField();

        panelForm.add(new JLabel("Nom Produit :")); panelForm.add(txtNom);
        panelForm.add(new JLabel("Quantité Initiale :")); panelForm.add(txtQte);
        panelForm.add(new JLabel("Seuil d'Alerte (Min) :")); panelForm.add(txtSeuil);
        panelForm.add(new JLabel("Fournisseur :")); panelForm.add(txtFournisseur);

        JButton btnAjouter = new JButton("Ajouter au Stock");
        btnAjouter.setBackground(new Color(70, 130, 180));
        btnAjouter.setForeground(Color.WHITE);
        
        
        String[] cols = {"ID", "Produit", "Quantité", "Seuil Alerte", "Fournisseur", "Statut"};
        model = new DefaultTableModel(cols, 0);
        table = new JTable(model);
        
        table.setDefaultRenderer(Object.class, new DefaultTableCellRenderer() {
            @Override
            public Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int column) {
                Component c = super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);
                
                try {
                    int qte = Integer.parseInt(table.getValueAt(row, 2).toString());
                    int seuil = Integer.parseInt(table.getValueAt(row, 3).toString());
                    
                    if (qte <= seuil) {
                        c.setBackground(new Color(255, 200, 200)); 
                        c.setForeground(Color.RED);
                    } else {
                        c.setBackground(Color.WHITE);
                        c.setForeground(Color.BLACK);
                    }
                    
                    if (isSelected) c.setBackground(Color.LIGHT_GRAY); 
                    
                } catch (Exception e) {}
                
                return c;
            }
        });
        
        JScrollPane scrollPane = new JScrollPane(table);

        JPanel panelBas = new JPanel();
        JButton btnSupprimer = new JButton("Supprimer Produit");
        JButton btnModifierQte = new JButton("Modifier Quantité (+/-)");
        
        btnSupprimer.setBackground(new Color(220, 20, 60)); btnSupprimer.setForeground(Color.WHITE);
        btnModifierQte.setBackground(Color.ORANGE);
        
        panelBas.add(btnModifierQte);
        panelBas.add(btnSupprimer);

        btnAjouter.addActionListener(e -> ajouterProduit());
        btnSupprimer.addActionListener(e -> supprimerProduit());
        btnModifierQte.addActionListener(e -> modifierQuantite());

        JPanel panelHaut = new JPanel(new BorderLayout());
        panelHaut.add(panelForm, BorderLayout.CENTER);
        panelHaut.add(btnAjouter, BorderLayout.SOUTH);
        
        add(panelHaut, BorderLayout.NORTH);
        add(scrollPane, BorderLayout.CENTER);
        add(panelBas, BorderLayout.SOUTH);

        chargerTable();
    }
    
    private void verifierAlertesDemarrage() {
        List<Produit> alertes = manager.getProduitsEnAlerte();
        if (!alertes.isEmpty()) {
            StringBuilder message = new StringBuilder("⚠️ ALERTE STOCK BAS ⚠️\n\n");
            for (Produit p : alertes) {
                message.append("- ").append(p.getNomProduit())
                       .append(" (Reste : ").append(p.getQuantite()).append(")\n");
            }
            message.append("\nVeuillez recommander ces produits !");
            
            JOptionPane.showMessageDialog(this, message.toString(), "Alerte Stock", JOptionPane.WARNING_MESSAGE);
        }
    }

    private void chargerTable() {
        model.setRowCount(0);
        for (Produit p : manager.listerProduits()) {
            String statut = p.estEnAlerte() ? "ALERTE !" : "OK";
            model.addRow(new Object[]{
                p.getId(), p.getNomProduit(), p.getQuantite(), p.getSeuilAlerte(), p.getFournisseur(), statut
            });
        }
    }

    private void ajouterProduit() {
        try {
            String nom = txtNom.getText();
            int qte = Integer.parseInt(txtQte.getText());
            int seuil = Integer.parseInt(txtSeuil.getText());
            String fourn = txtFournisseur.getText();
            
            manager.ajouterProduit(new Produit(nom, qte, seuil, fourn));
            chargerTable();
            txtNom.setText(""); txtQte.setText(""); txtFournisseur.setText("");
            JOptionPane.showMessageDialog(this, "Produit ajouté !");
        } catch (Exception ex) {
            JOptionPane.showMessageDialog(this, "Erreur (vérifiez les nombres) : " + ex.getMessage());
        }
    }

    private void supprimerProduit() {
        int row = table.getSelectedRow();
        if (row == -1) return;
        int id = (int) table.getValueAt(row, 0);
        
        if(JOptionPane.showConfirmDialog(this, "Supprimer ?", "Confirmer", JOptionPane.YES_NO_OPTION) == JOptionPane.YES_OPTION) {
            try {
                manager.supprimerProduit(id);
                chargerTable();
            } catch (SQLException ex) {
                JOptionPane.showMessageDialog(this, "Erreur : " + ex.getMessage());
            }
        }
    }

    private void modifierQuantite() {
        int row = table.getSelectedRow();
        if (row == -1) {
            JOptionPane.showMessageDialog(this, "Sélectionnez un produit.");
            return;
        }
        int id = (int) table.getValueAt(row, 0);
        int qteActuelle = (int) table.getValueAt(row, 2);
        
        String input = JOptionPane.showInputDialog(this, "Nouvelle quantité totale :", qteActuelle);
        if (input != null) {
            try {
                int nouvelleQte = Integer.parseInt(input);
                if (nouvelleQte < 0) throw new Exception("Pas de stock négatif");
                
                manager.mettreAJourQuantite(id, nouvelleQte);
                chargerTable();
                
                if (nouvelleQte <= (int) table.getValueAt(row, 3)) {
                    JOptionPane.showMessageDialog(this, "Attention : Ce produit est maintenant en alerte stock !");
                }
                
            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Erreur : " + ex.getMessage());
            }
        }
    }
}
