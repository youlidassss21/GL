package metier;

public class Produit {
    private int id;
    private String nomProduit;
    private int quantite;
    private int seuilAlerte;
    private String fournisseur;

    // Constructeur complet
    public Produit(int id, String nomProduit, int quantite, int seuilAlerte, String fournisseur) {
        this.id = id;
        this.nomProduit = nomProduit;
        this.quantite = quantite;
        this.seuilAlerte = seuilAlerte;
        this.fournisseur = fournisseur;
    }

    public Produit(String nomProduit, int quantite, int seuilAlerte, String fournisseur) {
        this.nomProduit = nomProduit;
        this.quantite = quantite;
        this.seuilAlerte = seuilAlerte;
        this.fournisseur = fournisseur;
    }

    public boolean estEnAlerte() {
        return quantite <= seuilAlerte;
    }

    public int getId() { return id; }
    public String getNomProduit() { return nomProduit; }
    public int getQuantite() { return quantite; }
    public int getSeuilAlerte() { return seuilAlerte; }
    public String getFournisseur() { return fournisseur; }
    
    
}
